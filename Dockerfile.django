FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first for better layer caching.
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Django app + reused FAQ data layer (pg.faq_api, shared with embed.py) + static frontend.
# programs.py is the shared programme registry, also copied into the embed image.
COPY backend /app/backend
COPY pg /app/pg
COPY programs.py /app/programs.py
COPY static /app/static

# /app       -> makes `pg.faq_api.*` importable
# /app/backend-> makes `config` / `chatbot` importable
ENV PYTHONPATH=/app/backend:/app
ENV DJANGO_SETTINGS_MODULE=config.settings

EXPOSE 8787

# One ASGI process lets async views share outbound connection pools and wait
# without holding request threads.
CMD ["uvicorn", "config.asgi:application", \
     "--host", "0.0.0.0", \
     "--port", "8787"]
